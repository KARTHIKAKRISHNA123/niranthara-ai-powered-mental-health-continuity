# backend/.env — Environment template
# Copy this to .env and fill in your values. Never commit .env to git.

PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING_GENERATE_WITH_COMMAND_ABOVE

# Sarvam AI — Tamil STT and translation
# Get key from: https://sarvam.ai — currently MOCKED if not set
SARVAM_API_KEY=REPLACE_WITH_SARVAM_KEY
