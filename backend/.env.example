    // backend/.env — Environment template
    // Copy this to .env and fill in your values. Never commit .env to git.

    PORT=5000
    NODE_ENV=development
    AI_SERVICE_URL=http://localhost:8000

    # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
    ENCRYPTION_KEY=REPLA

    # Sarvam AI — Tamil STT and translation
    # Get key from: https://sarvam.ai — currently using MOCK responses
    SARVAM_API_KEY=REPLACE_WITH_SARVAM_KEY
