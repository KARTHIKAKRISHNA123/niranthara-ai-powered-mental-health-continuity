# backend/.env — Environment template
# Copy this to .env and fill in your values. Never commit .env to git.

PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING_GENERATE_WITH_COMMAND_ABOVE

# Sarvam AI — Tamil STT and translation
# Get key from: https://sarvam.ai — currently MOCKED if not set
SARVAM_API_KEY=REPLACE_WITH_SARVAM_KEY

# ── Google Health API (cloud wearable path: Fitbit Charge 6, Pixel Watch) ─────
# This is the CLOUD route and needs no native module, so it works in Expo Go —
# unlike Health Connect, which requires a custom dev build.
#
# NOTE ON TIMING: the legacy Fitbit Web API is decommissioned 30 Sept 2026.
# Build against the Google Health API, not fitbit.com/oauth2.
#
# Setup:
#   1. console.cloud.google.com → new project → enable "Google Health API"
#   2. APIs & Services → OAuth consent screen → External → add yourself under
#      "Test users" (test mode works immediately; full verification is only
#      needed for public release)
#   3. Credentials → Create OAuth client ID → Web application
#      Authorised redirect URI must match GOOGLE_HEALTH_REDIRECT_URI exactly
#   4. Paste the client id/secret below and restart the backend
#
# Redirect URI must be reachable from the phone's browser — use the same LAN IP
# the app talks to, e.g. http://10.154.166.36:5000/api/google-health/callback
GOOGLE_HEALTH_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
GOOGLE_HEALTH_CLIENT_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET
GOOGLE_HEALTH_REDIRECT_URI=http://YOUR_LAN_IP:5000/api/google-health/callback
