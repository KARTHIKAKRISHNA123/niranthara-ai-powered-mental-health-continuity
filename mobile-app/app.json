{
  "expo": {
    "name": "Niranthara",
    "slug": "niranthara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.niranthara.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Niranthara uses your location to measure social activity patterns for personalised mental health support.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Niranthara uses location in the background to track GPS entropy as a passive wellbeing signal.",
        "NSMotionUsageDescription": "Niranthara uses your step count as a passive wellbeing signal to personalise your mental health continuity.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF7F2"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.niranthara.app",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Niranthara uses your location to measure social activity patterns for personalised mental health support.",
          "locationAlwaysAndWhenInUsePermission": "Niranthara uses location in the background to track GPS entropy as a passive wellbeing signal.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Niranthara uses your step count as a passive wellbeing signal."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C97B84",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d05ef5ad-a496-44a8-83c6-5c56ea80cb0c"
      }
    },
    "owner": "karthikakrishna123s-team"
  }
}
