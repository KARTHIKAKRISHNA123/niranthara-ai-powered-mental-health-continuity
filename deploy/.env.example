# deploy/.env — consumed by docker-compose itself (NOT by the app services).
# Copy to deploy/.env on the server and fill in. This file is gitignored via
# the root `.env*` rule.
#
# The application's own secrets stay where the code expects them:
#   backend/.env                    (PORT, ENCRYPTION_KEY, GOOGLE_HEALTH_*)
#   backend/serviceAccountKey.json  (Firebase Admin)
#   ai-service/.env                 (NVIDIA_API_KEY, SARVAM_API_KEY)
# Compose reads the first and third via `env_file:` and bind-mounts the second.

# Domain with an A record pointing at this VM. Required — Caddy uses it for TLS
# and the mobile app needs HTTPS (Android blocks cleartext on API 28+).
DOMAIN=niranthara.example.com

# ── Firebase web config ───────────────────────────────────────────────────────
# Build args for the dashboard bundle. Vite inlines these at build time, so
# changing one requires `docker compose up --build dashboard`, not a restart.
# Not secret: this config ships to every browser by design and is protected by
# Firestore security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
