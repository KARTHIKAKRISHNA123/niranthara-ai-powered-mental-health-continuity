# dashboard — React 19 / Vite 8, built to static assets and served by nginx.
# Build context is the REPO ROOT:
#   docker build -f deploy/Dockerfile.dashboard .

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:20-slim AS build

WORKDIR /app

COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci

COPY dashboard/ ./

# Vite inlines import.meta.env.VITE_* at BUILD time. These are build args, not
# runtime env vars — setting them in docker-compose `environment:` does nothing,
# the bundle is already compiled. They are not secrets: the Firebase web config
# ships to every browser by design and is protected by Firestore rules, not
# obscurity.
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_API_URL

RUN npm run build

# ── Stage 2: serve ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
