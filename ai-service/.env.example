# ai-service/.env — Environment template
# Copy this to .env and fill in your values. Never commit .env to git.

# NVIDIA NIM / Minimax-m2.7 API key for Gemma-equivalent responses
# Get from: https://build.nvidia.com — free tier available
# Without this key, the AI service uses static warm fallback responses (no LLM)
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY

# Sarvam AI — Tamil STT + translation
# Get from: https://sarvam.ai — currently MOCKED if not set
SARVAM_API_KEY=REPLACE_WITH_SARVAM_KEY

# HuggingFace model overrides (optional — defaults used if not set)
INDICBERT_MODEL=ai4bharat/indic-bert
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
