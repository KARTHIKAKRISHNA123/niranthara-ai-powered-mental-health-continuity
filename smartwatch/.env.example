# Niranthara Smartwatch Service — Environment Variables
# Copy this file to .env and fill in real values

PORT=5001

# Google OAuth 2.0 — create at console.cloud.google.com
# Enable: Fitness API, Health Connect API
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:5001/smartwatch/auth/callback

# Backend + AI service URLs (must match their running ports)
BACKEND_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:8000

# Encryption key — MUST match backend ENCRYPTION_KEY exactly (same 64-char hex)
ENCRYPTION_KEY=<64-char-hex-string-matching-backend-env>
